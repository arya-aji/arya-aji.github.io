  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one solid action per view (Describe your task, Start a project).",
      "html": "<a class=\"ds-btn\" href=\"#\">Describe your task</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:.5em;font-family:var(--font-display);font-weight:650;font-size:1.02rem;line-height:1.2;padding:.78em 1.2em;border-radius:var(--r-card);border:1.5px solid var(--accent);background:var(--accent);color:var(--on-accent);text-decoration:none;transition:background-color .15s ease,box-shadow .15s ease}.ds-btn:hover{background:var(--accent-strong);border-color:var(--accent-strong);box-shadow:var(--shadow)}.ds-btn:focus-visible{outline:3px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action beside a primary (See all work, Hire me on Upwork).",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">See all work</a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;font-family:var(--font-display);font-weight:650;font-size:1.02rem;line-height:1.2;padding:.78em 1.2em;border-radius:var(--r-card);border:1.5px solid var(--accent);background:transparent;color:var(--accent);text-decoration:none;transition:background-color .15s ease}.ds-btn-ghost:hover{background:var(--accent-tint)}.ds-btn-ghost:focus-visible{outline:3px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Estimates, prices, kinds and outcomes, like due dates on a task card.",
      "html": "<p class=\"ds-chips\"><span class=\"ds-chip ds-chip-kind\">Extension</span><span class=\"ds-chip\"><svg viewBox=\"0 0 16 16\" width=\"12\" height=\"12\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8 4.5V8l2.5 1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>3–5 days</span><span class=\"ds-chip\">$149–$349</span><span class=\"ds-chip ds-chip-outcome\">1,000+ users</span></p>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:.35rem;margin:0}.ds-chip{display:inline-flex;align-items:center;gap:.35em;font-family:var(--font-body);font-size:var(--step--1);line-height:1.3;padding:.2em .65em;border-radius:var(--r-chip);background:var(--column);color:var(--text);white-space:nowrap}.ds-chip-kind{font-weight:700;background:var(--board)}.ds-chip-outcome{background:var(--auto-tint);color:var(--heading)}"

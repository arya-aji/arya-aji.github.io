    {
      "name": "Task Card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "Raised paper card with a coloured top label stripe; lifts and tilts on hover in the Automated column.",
      "html": "<div class=\"ds-card\" style=\"--stripe:var(--ctp-yellow)\"><p class=\"ds-card-title\">Chrome extension that exports the orders in one click</p><p class=\"ds-card-meta\"><span class=\"ds-card-chip\">3–5 days</span><span class=\"ds-card-chip\">$149–$349</span></p></div>",
      "css": ".ds-card{--stripe:var(--line-strong);background:linear-gradient(var(--stripe),var(--stripe)) top/100% 5px no-repeat,var(--card);border-radius:var(--r-card);padding:.8rem .85rem .65rem;box-shadow:var(--shadow);font-family:var(--font-body);max-width:22rem;transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s ease}.ds-card:hover{transform:translateY(-2px) rotate(-.4deg);box-shadow:var(--shadow-lift)}.ds-card-title{margin:0;color:var(--heading);font-weight:600;line-height:1.4}.ds-card-meta{display:flex;gap:.35rem;margin:.5rem 0 0}.ds-card-chip{font-size:var(--step--1);padding:.2em .65em;border-radius:var(--r-chip);background:var(--column);color:var(--text)}"
    },
    {
      "name": "Moving Board",
      "kind": "custom",
      "refersTo": "board",
      "description": "Signature: a Mantle board with Crust columns, By hand (struck-through chores) to Automated (tool cards), with the mauve aa mover between.",
      "html": "<div class=\"ds-board\"><section class=\"ds-col\"><h3 class=\"ds-col-h\"><span class=\"ds-dot\" style=\"color:var(--hand)\"></span>By hand <span class=\"ds-count\">0 left</span></h3><div class=\"ds-tc ds-gone\">Merge five regional spreadsheets</div></section><div class=\"ds-mover\" aria-hidden=\"true\"><span class=\"ds-who\">aa</span><svg viewBox=\"0 0 48 16\" width=\"48\" height=\"16\"><path d=\"M1 8h42m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><section class=\"ds-col\"><h3 class=\"ds-col-h\"><span class=\"ds-dot\" style=\"color:var(--auto)\"></span>Automated <span class=\"ds-count\">1 done</span></h3><div class=\"ds-tc\" style=\"--stripe:var(--ctp-green)\">Python job that builds the report</div></section></div>",
      "css": ".ds-board{display:grid;grid-template-columns:1fr auto 1fr;gap:.75rem;padding:1rem;background:var(--board);border:1px solid var(--line);border-radius:var(--r-panel);font-family:var(--font-body)}.ds-col{background:var(--column);border-radius:14px;padding:.75rem;display:grid;gap:.5rem;align-content:start}.ds-col-h{display:flex;align-items:center;gap:.5rem;margin:0 0 .25rem;font-family:var(--font-display);font-size:1.05rem;color:var(--heading)}.ds-dot{width:.55em;height:.55em;border-radius:50%;background:currentColor}.ds-count{margin-left:auto;font:400 var(--step--1) var(--font-body);color:var(--subtext);background:var(--board);border-radius:var(--r-chip);padding:.1rem .6rem}.ds-tc{--stripe:var(--hand);background:linear-gradient(var(--stripe),var(--stripe)) top/100% 5px no-repeat,var(--card);border-radius:var(--r-card);padding:.8rem .85rem .65rem;box-shadow:var(--shadow);color:var(--heading);font-weight:600;line-height:1.4}.ds-gone{--stripe:var(--line-strong);background:linear-gradient(var(--stripe),var(--stripe)) top/100% 5px no-repeat,var(--column);box-shadow:inset 0 0 0 1px var(--line-strong);color:var(--subtext);text-decoration:line-through;text-decoration-color:var(--hand);text-decoration-thickness:2px}.ds-mover{display:flex;flex-direction:column;align-items:center;gap:.5rem;padding-top:2.5rem;color:var(--accent)}.ds-who{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:50%;background:var(--accent);color:var(--on-accent);font-family:var(--font-display);font-weight:760;letter-spacing:-.04em}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field with a strong line border and a mauve focus ring.",
      "html": "<label class=\"ds-field\"><span>What do you do by hand today?</span><textarea rows=\"3\" placeholder=\"Every Friday we copy 200 order IDs…\"></textarea></label>",
      "css": ".ds-field{display:grid;gap:.4rem;font-family:var(--font-body);font-weight:700;color:var(--text);max-width:28rem}.ds-field textarea{font:inherit;font-weight:400;color:var(--heading);background:var(--card);border:1.5px solid var(--line-strong);border-radius:var(--r-card);padding:.7rem .85rem;resize:vertical}.ds-field textarea:focus{outline:3px solid var(--accent);outline-offset:0;border-color:var(--accent)}"
